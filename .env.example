# ============================================================================
# LTC E-Learning — .env.example (dev local, 100% Docker)
# อ้างอิง: SDS.md §7.1–7.2 (env vars สองชั้น) + SRS Appendix A (defaults master — D8)
# หลักการ: โค้ดชุดเดียว ต่างกันเฉพาะ env vars (brief §6) — ห้าม hardcode ในโค้ด
#
# เริ่มใช้:  cp .env.example .env   แล้ว   make dev
#
# ค่าทั้งหมดด้านล่างเป็น "ค่า dev local เท่านั้น" — ไม่มี secret จริง
# ทุก secret ของ prod ต้องมาจาก env vars ของ platform (Vercel/Supabase Cloud) — ห้าม commit
#
# หมายเหตุมุมมอง URL: ไฟล์นี้เขียนจาก "มุมมอง host/browser" (localhost)
# - ภาชนะที่รันใน compose network จะถูก compose override ปลายทางให้เป็นชื่อ service
#   (SUPABASE_URL -> http://kong:8000, SMTP_HOST -> mailpit) ดู docker-compose.yml
# ============================================================================

# ----------------------------------------------------------------------------
# แอป (SDS §7.2 กลุ่ม "แอป")
# ----------------------------------------------------------------------------
# URL สาธารณะของแอป (ใช้สร้างลิงก์ในอีเมล/redirect)
PUBLIC_BASE_URL=http://localhost:3000
# URL ที่ใช้ generate QR ตรวจสอบประกาศนียบัตร (SDS §7.2 — QR ใช้ CERT_PUBLIC_BASE_URL)
CERT_PUBLIC_BASE_URL=http://localhost:3000
# local | prod — ใช้เฉพาะ infra/observability เท่านั้น ห้ามใช้ตัดสินใจ business logic (SDS §7.2)
APP_ENV=local
# dev default = debug / prod default = info (SDS §6.2)
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# Supabase (SDS §7.2 กลุ่ม "Supabase")
# ----------------------------------------------------------------------------
# Gateway ของ Supabase local (Kong) — prod สลับเป็น https://<project>.supabase.co
SUPABASE_URL=http://localhost:8000
# anon key (JWT role=anon) — ค่านี้ sign ด้วย SUPABASE_JWT_SECRET ด้านล่าง (dev placeholder)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IjAwMDAwMDAwMDAwMDAwMDAwMDAwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MzU2ODk2MDAsImV4cCI6MTg5MzQ1NjAwMH0.3jsTHD6cIxwRFtwetOAvCHSIQ0Z1xBxfki6n38cwPvk
# service_role key — server เท่านั้น ห้ามออกไป browser ห้าม log (brief §8)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IjAwMDAwMDAwMDAwMDAwMDAwMDAwIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTczNTY4OTYwMCwiZXhwIjoxODkzNDU2MDAwfQ.4m7tXPHtzmhd8_oafj7Xt0PDZFXn0I1WkNXrxJzwYtQ
# dev: เชื่อมตรง Postgres local (ใช้กับสคริปต์/psql) — prod: Supabase pooler (transaction mode) ตาม SDS §8
SUPABASE_DB_POOLER_URL=postgresql://postgres:postgres@localhost:54322/postgres
# JWT secret ของ Supabase local (ใช้โดย services ใน docker-compose.yml เท่านั้น)
# ถ้าเปลี่ยนค่านี้ ต้อง sign SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY ใหม่
# และแก้ key ใน docker/kong/kong.yml ให้ตรงกัน
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ----------------------------------------------------------------------------
# สื่อ (SDS §7.2 กลุ่ม "สื่อ") — abstraction สลับ dev/prod ด้วย MEDIA_PROVIDER
# ----------------------------------------------------------------------------
# dev = supabase_storage | prod = r2 | stream
MEDIA_PROVIDER=supabase_storage
# อายุ signed URL วิดีโอ/เอกสาร (วินาที) — default 900 (SDS §7.2; = media_signed_url_ttl_minutes=15 Appendix A)
MEDIA_SIGNED_URL_TTL_SEC=900

# --- ใช้เมื่อ MEDIA_PROVIDER=r2 (prod/staging เท่านั้น — ปล่อยว่างใน dev) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# --- ใช้เมื่อ MEDIA_PROVIDER=stream (prod/staging เท่านั้น — ปล่อยว่างใน dev) ---
# STREAM_ACCOUNT_ID=
# STREAM_API_TOKEN=
# STREAM_SIGNING_KEY_ID=
# STREAM_SIGNING_JWT_PRIVATE_KEY=

# ----------------------------------------------------------------------------
# อีเมล (SDS §7.2 กลุ่ม "อีเมล") — dev default = console (ไม่ส่งออกนอกเครื่อง)
# ----------------------------------------------------------------------------
# console = เขียนลง log | smtp = ส่งเข้า Mailpit (ดูที่ http://localhost:8025) | resend (prod)
EMAIL_PROVIDER=console
# มุมมอง host — ภาชนะแอปใน compose ถูก override เป็น mailpit อัตโนมัติ (docker-compose.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
# placeholder เท่านั้น — config schema บังคับ non-empty (EMAIL_PROVIDER=console ไม่ใช้จริง)
SMTP_USER=dev
SMTP_PASSWORD=dev
# ผู้ส่งที่แสดงในอีเมล
EMAIL_FROM=LTC E-Learning (dev) <no-reply@ltc.local>

# ----------------------------------------------------------------------------
# Rate limit (SDS §7.2 — ค่าเดียวกันทั้ง dev/prod, default จาก SRS Appendix A)
# ----------------------------------------------------------------------------
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_EXAM_PER_MIN=60
RATE_LIMIT_VERIFY_PER_MIN=120
RATE_LIMIT_READ_PER_MIN=120
RATE_LIMIT_LEARN_WRITE_PER_MIN=120
RATE_LIMIT_STAFF_WRITE_PER_MIN=60
RATE_LIMIT_MFA_PER_MIN=10
RATE_LIMIT_EXPORT_PER_HOUR=10
RATE_LIMIT_DEFAULT_PER_MIN=120

# ----------------------------------------------------------------------------
# Session / lockout (SDS §7.2 กลุ่ม "Session" + Appendix A)
# ----------------------------------------------------------------------------
# staff/admin: idle timeout (นาที)
SESSION_ADMIN_IDLE_MINUTES=15
# staff/admin: absolute session (ชั่วโมง)
SESSION_ADMIN_ABSOLUTE_HOURS=8
# ผู้เรียน: idle timeout (นาที) — learner_idle_timeout_minutes=60 (Appendix A)
SESSION_LEARNER_IDLE_MINUTES=60
# ล็อกบัญชีหลังกรอกรหัสผ่านผิด N ครั้งในหน้าต่างเวลา
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_DURATION_MINUTES=15

# ----------------------------------------------------------------------------
# การเรียน / สอบ (SDS §7.2 กลุ่ม "การเรียน" + Appendix A)
# ----------------------------------------------------------------------------
# ส่งสัญญาณดูวิดีโอทุกกี่วินาที
VIDEO_HEARTBEAT_SEC=15
# นับว่าเรียนจบเมื่อดูผ่านกี่ % (รอยืนยัน Q6)
VIDEO_COMPLETE_PCT=80
# เอกสาร: อ่านอย่างน้อยกี่วินาทีจึงนับ complete
DOC_MIN_DWELL_SEC=30
# สอบ: บันทึกคำตอบอัตโนมัติทุกกี่วินาที
EXAM_AUTOSAVE_SECONDS=15
# สอบ: หลุดการเชื่อมต่อกี่นาทีจึงปล่อยอุปกรณ์อื่นเข้าแทน (takeover)
EXAM_DISCONNECT_GRACE_MINUTES=5

# ----------------------------------------------------------------------------
# Postgres ของ Supabase local (ใช้โดย docker-compose.yml เท่านั้น — dev placeholder)
# ----------------------------------------------------------------------------
POSTGRES_PASSWORD=postgres
# พอร์ต DB ที่เปิดออก host — default ของระบบคือ 5432 ตาม ARCHITECTURE §4
# แต่เครื่อง dev นี้มี Postgres ของโปรเจกต์อื่นครอง 5432 อยู่ จึงตั้ง 54322 (ค่าเดียวกับ supabase CLI ใช้)
# ถ้าเครื่องคุณ 5432 ว่าง ตั้งกลับเป็น 5432 ได้ (อย่าลืมแก้ SUPABASE_DB_POOLER_URL ด้านบนให้ตรง)
POSTGRES_HOST_PORT=54322
