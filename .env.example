# ====================================================================
# LTC E-Learning Environment Configuration (Vercel + Supabase)
# ====================================================================

# Port for local dev server
PORT=3000
NODE_ENV=development

# 1. Supabase Cloud Configuration (Client-side exposed via VITE_)
# คัดลอกค่าจาก Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 2. Supabase Service Role Key (Server-side only — ห้าม expose ฝั่ง client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here
